{
  "name": "codex-local-mcp",
  "version": "0.0.0-development",
  "description": "MCP server that lets any LLM drive the local Codex CLI in a sandboxed workspace.",
  "type": "module",
  "bin": {
    "codex-local-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsc -p ui && node scripts/build-ui.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:tunnel": "node dist/index.js --tunnel --setup-login",
    "test": "vitest run",
    "test:browser": "npm run build && node scripts/test-browser-login.mjs",
    "prepublishOnly": "npm run build",
    "pretest": "node scripts/build-ui.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^26.5.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "esbuild": "^0.28.2",
    "playwright": "1.64.1",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "scripts/disabled-npm-plugin"
  ],
  "license": "MIT",
  "author": "OSS Malaysia",
  "homepage": "https://github.com/ossmalaysia/codex-local-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ossmalaysia/codex-local-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ossmalaysia/codex-local-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "codex",
    "openai-codex",
    "cli",
    "ai-agent",
    "image-generation",
    "claude"
  ]
}
