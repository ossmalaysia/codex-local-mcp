{
  "name": "codex-local-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets any LLM drive the local Codex CLI in a sandboxed workspace.",
  "type": "module",
  "bin": {
    "codex-local-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "OSS Malaysia",
  "homepage": "https://github.com/ossmalaysia/codex-local-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ossmalaysia/codex-local-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ossmalaysia/codex-local-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "codex",
    "openai-codex",
    "cli",
    "ai-agent",
    "image-generation",
