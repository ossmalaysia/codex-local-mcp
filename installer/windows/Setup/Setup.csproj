<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net48</TargetFramework><UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion><AssemblyName>CodexLocalMCP-Setup</AssemblyName><StartupObject>CodexLocalMCP.SetupEntry</StartupObject>
    <PlatformTarget>x64</PlatformTarget><Prefer32Bit>false</Prefer32Bit>
    <Product>Codex Local MCP Setup</Product><Company>OSS Malaysia</Company><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ApplicationManifest>../Manager/app.manifest</ApplicationManifest><ApplicationIcon>../Manager/Assets/app.ico</ApplicationIcon><Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" /><Compile Include="../Manager/*.cs" />
    <EmbeddedResource Include="../Manager/Assets/logo.png" LogicalName="CodexLocalMCP.logo.png" />
    <EmbeddedResource Include="$(SetupMetadata)" LogicalName="Setup.json" />
    <EmbeddedResource Include="$(SetupPayload)" LogicalName="Payload.zip" Condition="'$(SetupPayload)' != ''" />
    <EmbeddedResource Include="$(SetupUninstaller)" LogicalName="Uninstaller.exe" Condition="'$(SetupUninstaller)' != ''" />
    <Reference Include="System.Security" /><Reference Include="System.Net.Http" /><Reference Include="System.IO.Compression" /><Reference Include="System.IO.Compression.FileSystem" /><Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.CSharp" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
