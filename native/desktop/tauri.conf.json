{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Local MCP",
  "version": "0.8.0",
  "identifier": "com.ossmalaysia.codex-local-mcp",
  "build": { "frontendDist": "../desktop-ui/dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Codex Local MCP",
        "width": 1120,
        "height": 820,
        "minWidth": 800,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'",
      "capabilities": ["desktop"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../installer/windows/Manager/Assets/app.ico"],
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" } }
  }
}
